# App
NEXT_PUBLIC_APP_NAME="Next React Boilerplate"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_LOCALE="id"

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/next_boilerplate?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/next_boilerplate_test?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Mail (Mailpit in development, Resend/Postmark SMTP in production)
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="hello@example.com"
